---
import Layout from "../layouts/Layout.astro";
import FloatingBox from "../components/SmallBox.astro";
import { Config } from "../config";
import TimeLine from "../components/TimeLine.astro";
import ToolBox from "../components/ToolBox.astro";
import Title from "../components/Title.astro";
import CertificationTable from "../components/certification-table/CertificationTableGrid.astro";
import EventAppearances from "../components/EventAppearances.astro";
import CompaniesList from "../components/companies/CompaniesList.astro";
import Footer from "../components/Footer.astro";
import { tools, titles } from "../config.ts";

import { getCollection } from "astro:content";
const posts = (await getCollection("posts")).sort(function (
	first: any,
	second: any,
) {
	return second.data.publishedAt.getTime() - first.data.publishedAt.getTime();
});
---

<Layout>
	<main>
		<div class="flex flex-col gap-8 sm:gap-24">
			<article class="md:flex-row-reverse md:justify-end md:gap-12">
				<div class="flex flex-col justify-between sm:grid-cols-3 sm:grid">
					<div class="col-span-2 flex flex-col gap-6 md:gap-8 my-auto">
						<h1 class="text-3xl text-oleojake-primary">
							Hi, I’m {Config.me.name.split(" ")[0]} Marzal
						</h1>
						<h2 class="w-auto sm:w-[85%] md:w-[90%] leading-6">
							<strong class="font-bold text-oleojake-secondary"
								>Front-End Developer</strong
							> specialized in <strong class="font-bold text-oleojake-secondary"
								>React</strong
							> and <strong class="font-bold text-oleojake-secondary"
								>TypeScript</strong
							>. My background in e-commerce and digital marketing gives me a
							broader perspective when building user-focused products with
							business goals in mind.
						</h2>
						<div class="flex flex-col gap-3">
							<div class="custom-breadcrumbs">
								<ul>
									{
										Object.keys(Config.socials).map((social) => (
											<li>
												<a
													href={
														Config.socials[
															social as keyof typeof Config.socials
														]
													}
													rel="noreferrer"
													target="_blank"
												>
													{social.charAt(0).toUpperCase() + social.slice(1)}
												</a>
											</li>
										))
									}
								</ul>
							</div>
							<a
								href="/Pablo_Marzal_CV.pdf"
								download="Pablo_Marzal_CV.pdf"
								class="w-fit text-sm border border-oleojake-primary text-oleojake-primary px-4 py-1.5 rounded-md hover:bg-oleojake-primary hover:text-base-100 transition-all duration-300"
							>
								Resume
							</a>
						</div>
					</div>
					<div class="text-center mt-8 sm:ml-auto sm:m-0 sm:block">
						<div class="avatar">
							<div class="w-60 rounded-full">
								<img
									src="/profile-picture.webp"
									alt="Pablo Marzal"
									title="Pablo Marzal Profile Picture"
								/>
							</div>
						</div>
					</div>
				</div>
			</article>
			<article class="flex flex-col gap-8">
				<header class="flex w-full flex-row justify-between gap-2">
					<h3 class="text-lg tracking-tighter font-semibold">
						💻 Featured projects
					</h3>
					<a
						href={Config.me.projectLink}
						class="text-sm underline decoration-dashed underline-offset-8 text-oleojake-secondary hover:text-oleojake-primary"
						target="_blank"
						rel="noreferrer"
						>See all projects
					</a>
				</header>
				<section
					class="grid grid-cols-1 gap-4 sm:grid-cols-2 justify-center items-stretch"
				>
					{
						Object.keys(Config.projects).map((project) => (
							<FloatingBox
								title={project}
								href={
									Config.projects[project as keyof typeof Config.projects].url
								}
								tags={
									Config.projects[project as keyof typeof Config.projects].tags
								}
							/>
						))
					}
				</section>
			</article>
			<article class="flex flex-col gap-8">
				<header class="flex w-full flex-row justify-between gap-2">
					<h3 class="text-lg tracking-tighter font-semibold">📍 Journey</h3>
				</header>
				<section>
					<TimeLine />
				</section>
				<section class="flex flex-col gap-8">
					<CompaniesList />
				</section>
			</article>
			<article class="flex flex-col gap-8">
				<header class="flex w-full flex-row justify-between gap-2">
					<h3 class="text-lg tracking-tighter font-semibold">🛠️ Tools</h3>
				</header>
				<section class="pt-1 flex flex-row flex-wrap gap-2 justify-center">
					{tools.map((tool) => <ToolBox title={tool.title} icon={tool.icon} />)}
				</section>
			</article>
			<article class="flex flex-col gap-8">
				<header class="flex w-full flex-row justify-between gap-2">
					<h3 class="text-lg tracking-tighter font-semibold">
						🎓 Certificates
					</h3>
				</header>
				<section class="grid grid-cols-2 gap-4 sm:grid sm:grid-cols-4">
					{
						titles.map((title, index) => (
							<Title title={title.title} src={title.src} id={index} />
						))
					}
				</section>
				<CertificationTable />
			</article>
			<article class="flex flex-col gap-8">
				<header class="flex w-full flex-row justify-between gap-2">
					<h3 class="text-lg tracking-tighter font-semibold">
						📢 Teaching & Event appearances
					</h3>
				</header>
				<EventAppearances />
			</article>

			<article class="flex flex-col gap-8">
				<header class="flex w-full flex-row justify-between gap-2">
					<h3 class="text-lg">Latest Articles</h3>
					<a
						href="/posts"
						class="text-sm underline decoration-dashed underline-offset-8 text-oleojake-secondary hover:text-oleojake-primary"
						>See all articles
					</a>
				</header>
				<section class="grid grid-cols-1 gap-4 sm:grid-cols-2 mx-auto">
					{
						posts.map((post: any) => (
							<FloatingBox
								title={post.data.title}
								publishedAt={post.data.publishedAt.toLocaleDateString("en-us", {
									year: "numeric",
									month: "short",
									day: "numeric",
								})}
								description={post.data.description}
								href={"/posts/" + post.slug}
							/>
						))
					}
				</section>
			</article>
		</div>
	</main>
	<Footer />
</Layout>
